@using Forms.Models
@model List<ConversionModel>

<div class="text-center">
    <h1 class="display-4">History</h1>
    <br>
    <table class="table">
        <thead>
            <tr>
                <th>Problem ID</th>
                <th>Distance</th>
                <th>Distance Unit</th>
                <th>Time</th>
                <th>Time Unit</th>
                <th>Speed</th>
                <th>Speed Unit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var conversionModel in Model)
            {
                <tr>
                    <td>@conversionModel.ProblemID</td>
                    <td>@conversionModel.Distance</td>
                    <td>@conversionModel.DisUnit</td>
                    <td>@conversionModel.Time</td>
                    <td>@conversionModel.TimeUnit</td>
                    <td>@conversionModel.Speed</td>
                    <td>@conversionModel.SpeedUnit</td>
                </tr>
            }
        </tbody>
    </table>
</div>
